<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>RhythmBase.RhythmDoctor.Components.Lang</RootNamespace>
		<AssemblyName>RhythmBase.RhythmDoctor.Lang</AssemblyName>
		<Version>1.3.13</Version>
		<Title>RhythmBase.RhythmDoctor.Lang</Title>
		<Description>Expression language (ANTLR grammar, evaluators and the ExpressionContext sandbox) for the Rhythm Doctor adapter.</Description>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<LangVersion>Preview</LangVersion>
		<IsAotCompatible>false</IsAotCompatible>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>RhythmBase_logo_small.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="../DotnetCompatibility.cs" />
		<PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
		<None Include="../LICENSE.txt;../RhythmBase_logo_small.png" Pack="True" PackagePath="/" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="../RhythmBase.RhythmDoctor/RhythmBase.RhythmDoctor.csproj" />
	</ItemGroup>
</Project>
